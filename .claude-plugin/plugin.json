{
  "name": "cache-timer",
  "version": "0.4.5",
  "description": "Prompt cache countdown and auto-compact for Claude Code: a progress bar in the status line and above the prompt, a /cache pane with stats, expiry reminders, and compaction before the cache expires so you don't pay to re-cache a long context",
  "author": { "name": "mileschintw", "url": "https://github.com/mileschintw" },
  "homepage": "https://github.com/mileschintw/claude-cache-timer",
  "repository": "https://github.com/mileschintw/claude-cache-timer",
  "documentationUrl": "https://github.com/mileschintw/claude-cache-timer#usage",
  "supportUrl": "https://github.com/mileschintw/claude-cache-timer/issues",
  "privacyPolicyUrl": "https://github.com/mileschintw/claude-cache-timer#privacy-and-permissions",
  "license": "MIT",
  "keywords": ["claude-code", "prompt-caching", "prompt-cache", "cache-ttl", "countdown", "auto-compact", "compact", "statusline", "progress-bar", "token-usage", "cost", "mod"],
  "types": "./types/index.d.ts",
  "userConfig": {
    "lang": {
      "type": "string",
      "title": "Language",
      "description": "UI language of the band, pane, reminders and /cache replies",
      "options": ["en", "zh-TW"],
      "default": "en"
    }
  }
}
